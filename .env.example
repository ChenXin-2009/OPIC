# Microsoft Planetary Computer API Configuration
# 可选：如果您有 MPC 订阅密钥，可以在此配置以提高 API 请求限制
# 留空则使用默认公共访问

# MPC_API_KEY=your_subscription_key_here

# Esri ArcGIS API Key
# 用于访问 Esri World Imagery 和其他 ArcGIS 服务
# 获取方式：https://developers.arcgis.com/
NEXT_PUBLIC_ESRI_API_KEY=your_esri_api_key_here

# Cesium Ion Access Token
# 用于访问 Cesium Ion 服务（地球瓦片、地形等）
# 获取方式：https://ion.cesium.com/tokens
# 留空则使用 Cesium 默认 token
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Cesium Base URL
# Cesium 静态资源的基础路径
# 默认值：/cesium/
NEXT_PUBLIC_CESIUM_BASE_URL=/cesium/

# 缓存配置
# 服务端瓦片缓存时长（秒），默认 30 天
# TILE_CACHE_MAX_AGE=2592000

# SAS Token 缓存时长（秒），默认 50 分钟
# SAS_TOKEN_CACHE_MAX_AGE=3000

# Supabase Configuration
# 用于用户认证和数据存储
# 获取方式：https://supabase.com/dashboard → 项目设置 → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# Global Challenges Visualization MODs API Keys
# ============================================

# OpenWeatherMap API Key
# 用于 Weather MOD 和 Air Quality MOD
# 获取方式：https://openweathermap.org/api
NEXT_PUBLIC_OPENWEATHER_API_KEY=

# AQICN (Air Quality Index) API Key
# 用于 Air Quality MOD
# 获取方式：https://aqicn.org/data-platform/token/
NEXT_PUBLIC_AQICN_API_KEY=

# NASA FIRMS (Fire Information for Resource Management System) API Key
# 用于 Wildfire MOD
# 获取方式：https://firms.modaps.eosdis.nasa.gov/api/area/
NEXT_PUBLIC_NASA_FIRMS_API_KEY=

# IUCN Red List API Key
# 用于 Endangered Species MOD
# 获取方式：https://apiv3.iucnredlist.org/api/v3/token
NEXT_PUBLIC_IUCN_API_KEY=

# ACLED (Armed Conflict Location & Event Data) API Key
# 用于 Armed Conflict MOD
# 获取方式：https://developer.acleddata.com/
NEXT_PUBLIC_ACLED_API_KEY=

# ============================================
# Optional: Data Source Configuration
# ============================================

# Data sources configuration file path
# 默认值：/config/data-sources.json
# DATA_SOURCES_CONFIG_PATH=/config/data-sources.json

