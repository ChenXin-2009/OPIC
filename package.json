{
  "name": "opic",
  "version": "11.15.2",
  "description": "A Web-based multi-scale universe visualization and astronomical data integration system - Open Integrated Cosmos",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:wasm": "cd rust-sgp4 && cargo build --target wasm32-unknown-unknown --release && wasm-bindgen --target no-modules --out-dir pkg ./target/wasm32-unknown-unknown/release/opic_sgp4.wasm && copy /Y pkg\\opic_sgp4.js ..\\public\\wasm && copy /Y pkg\\opic_sgp4_bg.wasm ..\\public\\wasm && copy /Y pkg\\opic_sgp4.d.ts ..\\public\\wasm",
    "prebuild": "npm run generate-mods",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "quality:check": "npm run lint && tsc --noEmit && npm test",
    "convert-ucs-data": "npx tsx scripts/convert-ucs-data.ts",
    "generate-mods": "node scripts/generate-mod-registry.js",
    "release": "npx standard-version",
    "release:major": "npx standard-version --release-as major",
    "release:minor": "npx standard-version --release-as minor",
    "release:patch": "npx standard-version --release-as patch",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:detailed": "cross-env ANALYZE=true next build --debug",
    "perf:report": "cross-env ANALYZE=true next build",
    "perf:lighthouse": "npx tsx scripts/perf-lighthouse.ts",
    "perf:baseline": "npm run build && npx tsx scripts/perf-baseline.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@cesium/engine": "^23.0.1",
    "@mimo-ai/mimocode-windows-x64-baseline": "^0.1.5",
    "@types/cesium": "^1.67.14",
    "@vercel/analytics": "^1.5.0",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^1.2.0",
    "astronomy-engine": "^2.1.19",
    "cesium": "^1.139.1",
    "csv-parse": "^6.1.0",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.1.0",
    "next": "^16.0.7",
    "pako": "^2.1.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "satellite.js": "^6.0.2",
    "sharp": "^0.34.5",
    "three": "^0.170.0",
    "troika-three-text": "^0.52.4",
    "web-vitals": "^5.3.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@next/bundle-analyzer": "^16.2.9",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pako": "^2.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.170.0",
    "babel-plugin-react-compiler": "1.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "fast-check": "^4.4.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lighthouse": "^13.4.0",
    "lint-staged": "^17.0.7",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "typescript": "^5"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 200",
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ],
    "**/*.{css,scss}": [
      "prettier --write"
    ]
  }
}
